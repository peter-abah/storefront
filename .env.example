# Maison Editorial Shop — env template (copy to .env.local and fill)
# Docs: docs/ARCHITECTURE.md §8. No real secrets here. Never commit .env.local.

# --- Database ---
# Dev default: local Docker (docker compose up -d db). No Neon needed locally.
DATABASE_URL=postgresql://maison:maison@localhost:5432/maison
# Migrations: direct/unpooled URL for Neon DDL. Leave blank locally (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=
# Prod override (Vercel env only, never here): Neon pooled URL, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=replace-with-32-plus-char-random
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails auto-promoted to admin on first sign-in.
ADMIN_EMAILS=
OWNER_EMAIL=
# Shop contact identity (Phase 1 trust shell; DRAFTs live in lib/contact.ts).
# Set these to verified values before prod launch.
SUPPORT_PHONE=+2348031234567
WHATSAPP_URL=https://wa.me/2348031234567
STORE_ADDRESS=14 Admiralty Way, Lekki Phase 1, Lagos
STORE_HOURS=Mon–Sat 9:00–18:00 WAT; Sun WhatsApp only

# --- Images (Cloudinary Free) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signed upload preset for admin product uploads.
CLOUDINARY_UPLOAD_PRESET=maison_products

# --- Email (provider port; V1 = Mailgun sandbox, no custom domain) ---
EMAIL_PROVIDER=mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=sandboxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.mailgun.org
MAILGUN_FROM=Maison <mailgun@sandboxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.mailgun.org>
MAILGUN_REGION=US
# Authorized sandbox recipient — all 3 order mails fan out here in dev (max 5, must click invite).
TEST_INBOX=
NOTIFY_SECRET=replace-with-long-random
# Future only (Resend swap = implement lib/email/resend.ts + flip EMAIL_PROVIDER).
RESEND_API_KEY=
RESEND_FROM=
APP_URL=http://localhost:3000
