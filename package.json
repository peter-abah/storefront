{
  "name": "maison-monorepo",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @maison/web dev",
    "build:web": "pnpm --filter @maison/web build",
    "start:web": "pnpm --filter @maison/web start",
    "dev:mobile": "pnpm --filter @maison/mobile start",
    "android:mobile": "pnpm --filter @maison/mobile android",
    "lint": "pnpm --filter @maison/web lint",
    "db:generate": "pnpm --filter @maison/web db:generate",
    "db:migrate": "pnpm --filter @maison/web db:migrate",
    "db:check": "pnpm --filter @maison/web db:check",
    "db:push": "pnpm --filter @maison/web db:push",
    "db:setup": "pnpm --filter @maison/web db:setup",
    "db:status": "pnpm --filter @maison/web db:status",
    "db:migrate:local": "pnpm --filter @maison/web db:migrate:local"
  }
}
